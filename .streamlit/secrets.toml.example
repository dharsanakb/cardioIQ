# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud "Secrets" panel.
# NEVER commit the real secrets.toml.

# Optional. Without it the app uses a local SQLite file (data resets on Streamlit Cloud restarts).
# Supabase/Neon example (keep ?sslmode=require):
DATABASE_URL = "postgresql://user:password@host:5432/postgres?sslmode=require"

# Optional. Without it the AI Summary tab falls back to a template-based summary.
ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-5-5"

# Doctor accounts. Generate a hash with:
#   python -c "import hashlib; print(hashlib.sha256(b'your-password').hexdigest())"
# Without this section the app runs in demo mode (user: doctor / password: cardioiq123).
[users.drrao]
name = "Dr. Rao"
password_sha256 = "paste-hash-here"
